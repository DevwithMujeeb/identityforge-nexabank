# NexaBank API — Environment Variables
# Copy this to .env and fill in real values. Never commit .env.

# Server
PORT=3000
NODE_ENV=development

# Keycloak
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM_STAFF=nexabank-staff
KEYCLOAK_REALM_AGENTS=nexabank-agents
KEYCLOAK_REALM_PARTNERS=nexabank-partners
KEYCLOAK_CLIENT_ID=nexabank-api
KEYCLOAK_CLIENT_SECRET=change-me

# mTLS
MTLS_CA_CERT=/certs/ca.crt
MTLS_SERVER_CERT=/certs/server.crt
MTLS_SERVER_KEY=/certs/server.key

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexabank
DB_USER=nexabank_app
DB_PASSWORD=change-me

# Audit
AUDIT_LOG_PATH=/var/log/nexabank/audit.log

# Anomaly Detection
ANOMALY_AGENT_URL=http://localhost:5001
REVOCATION_TIMEOUT_SECONDS=60
OFFBOARDING_TIMEOUT_MINUTES=30
